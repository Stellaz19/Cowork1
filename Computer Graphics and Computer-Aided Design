<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #f5f7fb;
    font-family: Arial, "Segoe UI", sans-serif;
    color: #172033;
}

.container {
    max-width: 1400px;
    margin: auto;
    padding: 30px;
}

header {
    margin-bottom: 25px;
}

h1 {
    margin: 0 0 8px 0;
    font-size: 32px;
}

.subtitle {
    color: #667085;
    margin: 0;
}

.metrics {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 15px;
    margin-bottom: 20px;
}

.metric {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 18px;
}

.metric-title {
    font-size: 13px;
    color: #667085;
}

.metric-value {
    font-size: 25px;
    font-weight: bold;
    margin-top: 7px;
}

.note {
    background: #eef4ff;
    border-left: 4px solid #3578e5;
    padding: 15px 18px;
    border-radius: 10px;
    margin-bottom: 20px;
    line-height: 1.6;
}

.grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
}

.card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 12px;
    box-shadow: 0 3px 12px rgba(0,0,0,0.04);
}

.full {
    grid-column: 1 / -1;
}

.interpretation {
    padding: 20px;
    line-height: 1.7;
}

.interpretation h2 {
    margin-top: 0;
}

footer {
    margin-top: 25px;
    color: #667085;
    font-size: 13px;
}

@media (max-width: 1000px) {
    .metrics {
        grid-template-columns: repeat(2, 1fr);
    }

    .grid {
        grid-template-columns: 1fr;
    }

    .full {
        grid-column: auto;
    }
}

@media (max-width: 600px) {
    .container {
        padding: 15px;
    }

    .metrics {
        grid-template-columns: 1fr;
    }
}

</style>

</head>

